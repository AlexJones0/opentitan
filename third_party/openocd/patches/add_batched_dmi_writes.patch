+static struct drscan_batch_context drscan_batch_ctx;
+
 struct jtag_tap *jtag_tap_by_jim_obj(Jim_Interp *interp, Jim_Obj *o)
 {
 	const char *cp = Jim_GetString(o, NULL);
@@ -212,6 +215,258 @@ static int jim_command_drscan(Jim_Interp *interp, int argc, Jim_Obj * const *arg
